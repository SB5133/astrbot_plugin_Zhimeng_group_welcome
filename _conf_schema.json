    "items": {
      "group_1": { "description": "群 1", "type": "object", "items": {
        "group_id": { "description": "群号", "type": "string", "hint": "留空表示该槽位未使用", "default": "" },
        "welcome_text": { "description": "欢迎文字", "type": "string", "default": "" },
        "welcome_img": { "description": "欢迎图片", "type": "string", "hint": "URL 或 data/zhiMeng_group_welcome 下的文件名", "default": "" },
        "bye_text": { "description": "退群文字", "type": "string", "default": "" },
